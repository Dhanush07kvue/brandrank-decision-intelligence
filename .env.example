# Backend paths are optional. If omitted, the app uses project-relative paths:
# data/input, data/working, and data/output.
# For Windows, use absolute paths such as C:\path\to\project\data\working.
# BAI_INPUT_ROOT=
# BAI_WORKING_DIR=
# BAI_OUTPUT_DIR=
# BAI_DB_PATH=
BAI_STORAGE_MODE=duckdb
# BAI_POSTGRES_URL=postgresql+psycopg://brandrank_app:brandrank_dev_pw@127.0.0.1:5432/brandrank_poc
# BAI_POSTGRES_POOL_SIZE=5
# BAI_POSTGRES_MAX_OVERFLOW=10

# Single-brand local POC context
BAI_BRAND_ID=aveeno
BAI_BRAND_DISPLAY=Aveeno
BAI_MARKET=US
BAI_LANGUAGE=en-US
BAI_SOURCE_SYSTEM=BrandRank

# Azure/OpenAI-compatible custom endpoint (optional)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=YOUR_AZURE_OPENAI_API_KEY
OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=YOUR_CHAT_DEPLOYMENT
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=YOUR_EMBEDDINGS_DEPLOYMENT

# Compatibility fallbacks for existing code paths
OPENAI_API_KEY=YOUR_AZURE_OPENAI_API_KEY
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_BASE=https://your-resource.openai.azure.com
OPENAI_API_MODE=auto
CHAT_DEPLOYMENT=YOUR_CHAT_DEPLOYMENT

# Managed responses mode (optional alternative)
# Example target request: POST {OPENAI_API_BASE}/responses with header apikey
# OPENAI_API_BASE=https://dev.awsna.api.kenvue.com/openai/managed
# OPENAI_API_KEY=YOUR_MANAGED_API_KEY
# OPENAI_MODEL=gpt-5.4
# OPENAI_API_MODE=managed_responses
# Frontend API base. Leave empty for IIS same-origin hosting (/api).
# VITE_API_BASE_URL=
