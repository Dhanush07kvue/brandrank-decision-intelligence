<mxfile host="app.diagrams.net" modified="2026-08-08T00:00:00.000Z" agent="Codex" version="24.7.17" type="device"><diagram id="01-cpg" name="01 — Executive Reference Architecture"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Enterprise CPG AI Discovery &amp;amp; Decision Intelligence" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=27;fontColor=#172033;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1520" height="42" as="geometry" /></mxCell><mxCell id="subtitle" value="Source-agnostic • Brand-neutral • Market-aware • Product-aware • Closed-loop" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=14;fontColor=#56657A;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="67" width="1520" height="26" as="geometry" /></mxCell><mxCell id="p1-01" value="&lt;b&gt;SOURCES / SENSORS&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;External AI / AEO / GEO sources&lt;br&gt;Retail • search • commerce • web / citations&lt;br&gt;Enterprise truth and master data&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7E9ED;strokeColor=#AEB8C5;fontColor=#172033;fontSize=16;fontStyle=1;spacing=8;arcSize=10;" vertex="1" parent="1"><mxGeometry x="160" y="115" width="1220" height="64" as="geometry" /></mxCell><mxCell id="p1-02" value="&lt;b&gt;ACQUISITION&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;File • API • SFTP • event&lt;br&gt;Ingestion gateway • manifest • schema fingerprint&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7E9ED;strokeColor=#AEB8C5;fontColor=#172033;fontSize=16;fontStyle=1;spacing=8;arcSize=10;" vertex="1" parent="1"><mxGeometry x="160" y="205" width="1220" height="64" as="geometry" /></mxCell><mxCell id="p1-03" value="&lt;b&gt;GOVERNED DATA FOUNDATION&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;Immutable raw evidence → Bronze → Silver canonical observations&lt;br&gt;Gold data products • semantic contracts • lineage&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEBFA;strokeColor=#AEB8C5;fontColor=#172033;fontSize=16;fontStyle=1;spacing=8;arcSize=10;" vertex="1" parent="1"><mxGeometry x="160" y="295" width="1220" height="64" as="geometry" /></mxCell><mxCell id="p1-04" value="&lt;b&gt;DECISION INTELLIGENCE&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;Governed metrics → Signals → Diagnosis + enterprise truth&lt;br&gt;Decision → Intervention → publish&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF2E4;strokeColor=#AEB8C5;fontColor=#172033;fontSize=16;fontStyle=1;spacing=8;arcSize=10;" vertex="1" parent="1"><mxGeometry x="160" y="385" width="1220" height="64" as="geometry" /></mxCell><mxCell id="p1-05" value="&lt;b&gt;AGENTIC / EXPERIENCE&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;Web app • APIs • assistant • BI • Genie • command centre&lt;br&gt;Explain and retrieve; never replace deterministic controls&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6F1EF;strokeColor=#AEB8C5;fontColor=#172033;fontSize=16;fontStyle=1;spacing=8;arcSize=10;" vertex="1" parent="1"><mxGeometry x="160" y="475" width="1220" height="64" as="geometry" /></mxCell><mxCell id="p1-06" value="&lt;b&gt;SYSTEMS OF EXECUTION&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;Workflow • DAM • PIM • CMS / DXP&lt;br&gt;Commerce • retail • ESP connectors&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE5C7;strokeColor=#AEB8C5;fontColor=#172033;fontSize=16;fontStyle=1;spacing=8;arcSize=10;" vertex="1" parent="1"><mxGeometry x="160" y="565" width="1220" height="64" as="geometry" /></mxCell><mxCell id="p1-07" value="&lt;b&gt;MEASUREMENT LOOP&lt;/b&gt;&lt;br&gt